---
import type { PageCopy } from '../i18n/content';

interface Props {
  content: PageCopy['demo'];
  id?: string;
}

const { content, id = 'demo' } = Astro.props;
---

<section class="content-section demo-section" id={id}>
  <div class="section-intro">
    <p class="section-kicker">{content.kicker}</p>
    <h2>{content.title}</h2>
    <p>{content.description}</p>
  </div>

  <div
    class="demo-console"
    data-demo-root
    data-thinking={content.thinking}
    data-tool-label={content.toolLabel}
    data-replay={content.reset}
  >
    <div class="demo-topline">
      <div class="demo-disclaimer">
        <span class="demo-dot" aria-hidden="true"></span>
        {content.disclaimer}
      </div>
      <button type="button" class="demo-replay" data-demo-replay aria-label={content.reset}>
        <span aria-hidden="true">↻</span> {content.reset}
      </button>
    </div>

    <div class="demo-thread" data-demo-thread aria-live="polite"></div>
  </div>
</section>

<style>
  .demo-section { scroll-margin-top: 90px; }

  .demo-console {
    margin-top: 2rem;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--panel);
    box-shadow: var(--shadow);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    backdrop-filter: blur(12px);
  }

  .demo-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .demo-disclaimer {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .demo-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(120deg, var(--violet), var(--blue));
    box-shadow: 0 0 0 4px rgba(138, 77, 255, 0.14);
    flex-shrink: 0;
  }

  .demo-replay {
    font: inherit;
    font-size: 0.82rem;
    color: var(--text);
    background: rgba(138, 77, 255, 0.1);
    border: 1px solid rgba(138, 77, 255, 0.28);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease;
  }
  .demo-replay:hover { background: rgba(138, 77, 255, 0.2); border-color: rgba(138, 77, 255, 0.5); }
  .demo-replay:disabled { opacity: 0.5; cursor: default; }

  .demo-thread {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 360px;
    max-height: 460px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  .demo-msg { display: flex; flex-direction: column; gap: 0.5rem; max-width: 92%; }
  .demo-msg-user { align-self: flex-end; align-items: flex-end; }

  .demo-bubble {
    border-radius: 16px;
    padding: 0.8rem 1rem;
    line-height: 1.55;
    font-size: 0.92rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .demo-msg-user .demo-bubble {
    background: linear-gradient(120deg, rgba(138, 77, 255, 0.85), rgba(30, 167, 255, 0.75));
    color: #fff;
    border-bottom-right-radius: 4px;
  }
  .demo-msg-agent .demo-bubble {
    background: var(--panel-strong);
    border: 1px solid var(--line);
    color: var(--text);
    border-bottom-left-radius: 4px;
  }

  .demo-tools { display: flex; flex-direction: column; gap: 0.4rem; }
  .demo-tool {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(13, 10, 29, 0.6);
    overflow: hidden;
  }
  .demo-tool > summary {
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    color: var(--text);
  }
  .demo-tool > summary::-webkit-details-marker { display: none; }
  .demo-tool-badge {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: rgba(30, 167, 255, 0.16);
    border: 1px solid rgba(30, 167, 255, 0.4);
    color: var(--text);
  }
  .demo-tool-name {
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    color: var(--blue);
  }
  .demo-tool pre {
    margin: 0;
    padding: 0.75rem;
    border-top: 1px solid var(--line);
    background: var(--bg-deep);
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.74rem;
    line-height: 1.5;
    overflow-x: auto;
    color: var(--muted);
    max-height: 240px;
    overflow-y: auto;
  }

  .demo-thinking {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .demo-thinking .demo-dot { animation: demo-pulse 1s ease-in-out infinite; }
  @keyframes demo-pulse { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  .demo-caret {
    display: inline-block;
    width: 0.5ch;
    background: currentColor;
    opacity: 0.7;
    animation: demo-blink 1s step-end infinite;
    margin-left: 1px;
  }
  @keyframes demo-blink { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .demo-thinking .demo-dot, .demo-caret { animation: none; }
  }
</style>

<script>
  type Step =
    | { t: 'user'; text: string }
    | { t: 'think' }
    | { t: 'tool'; name: string; result: string }
    | { t: 'reply'; text: string };

  // Scripted, canned sessions — pure animation, no network, no LLM, no cost.
  const SCENARIOS: Step[][] = [
    [
      { t: 'user', text: '¿Quién tiene acceso de más en este tenant?' },
      { t: 'think' },
      {
        t: 'tool',
        name: 'run_access_review',
        result:
          '{\n  "users": 6, "serviceAccounts": 4, "anomalies": 4,\n  "recommendations": [\n    { "type": "downgrade", "subject": "carlos.founder@…", "why": "OWNER inactivo ~6 meses" },\n    { "type": "require_password_reset", "subject": "priya.admin@…", "why": "sin passkey + login país nuevo" },\n    { "type": "rotate_service_account_secret", "subject": "legacy-etl", "why": "dormido ~7 meses, sin rotación" }\n  ]\n}',
      },
      {
        t: 'reply',
        text: 'Encontré tres cosas: un OWNER inactivo hace ~6 meses (lo bajaría a MEMBER), un ADMIN sin passkey con login desde un país nuevo (pediría reset), y un service account dormido hace 7 meses sin rotación. Te dejo las recomendaciones para aprobar con un click.',
      },
    ],
    [
      { t: 'user', text: 'Compilá una policy: OWNER hace todo, MEMBER solo GET /vaults, default deny.' },
      { t: 'think' },
      {
        t: 'tool',
        name: 'generate_policy',
        result:
          '{\n  "default": "deny",\n  "rules": [\n    { "effect": "allow", "roleIn": ["OWNER"], "methods": ["*"], "pathGlob": "/**" },\n    { "effect": "allow", "roleIn": ["MEMBER"], "methods": ["GET"], "pathGlob": "/vaults/**" }\n  ],\n  "applied": false\n}',
      },
      {
        t: 'reply',
        text: 'Listo — compilé la PolicySet (default deny, MEMBER read-only en /vaults). Es read-only: no la apliqué. Un humano la revisa y recién la enforcea.',
      },
    ],
    [
      { t: 'user', text: 'Verificá que este documento no fue alterado.' },
      { t: 'think' },
      {
        t: 'tool',
        name: 'verify_document',
        result:
          '{\n  "status": "ANCHORED",\n  "provider": "rfc3161-tsa",\n  "rootIntact": true,\n  "timestampedAt": "2026-08-10T08:00:00Z"\n}',
      },
      {
        t: 'reply',
        text: 'Verificado: anclado vía RFC 3161 y el hash coincide con el root — el documento existió en esa fecha y no cambió.',
      },
    ],
  ];

  const root = document.querySelector<HTMLElement>('[data-demo-root]');
  if (root) {
    const thread = root.querySelector<HTMLElement>('[data-demo-thread]')!;
    const replayBtn = root.querySelector<HTMLButtonElement>('[data-demo-replay]')!;
    const strings = {
      thinking: root.dataset.thinking ?? 'Thinking…',
      toolLabel: root.dataset.toolLabel ?? 'Tool',
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let scenarioIdx = 0;
    let running = false;
    let runId = 0;
    let loopTimer: ReturnType<typeof setTimeout> | undefined;

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const toEnd = () => { thread.scrollTop = thread.scrollHeight; };

    const bubble = (role: 'user' | 'agent') => {
      const wrap = document.createElement('div');
      wrap.className = `demo-msg demo-msg-${role}`;
      const b = document.createElement('div');
      b.className = 'demo-bubble';
      wrap.appendChild(b);
      thread.appendChild(wrap);
      toEnd();
      return b;
    };

    const typeInto = async (el: HTMLElement, text: string, speed: number, id: number) => {
      if (reduce) { el.textContent = text; toEnd(); return; }
      const caret = document.createElement('span');
      caret.className = 'demo-caret';
      caret.textContent = ' ';
      el.appendChild(caret);
      for (let i = 0; i < text.length; i++) {
        if (id !== runId) return;
        caret.insertAdjacentText('beforebegin', text[i]);
        toEnd();
        await sleep(speed);
      }
      caret.remove();
    };

    const thinking = () => {
      const wrap = document.createElement('div');
      wrap.className = 'demo-msg demo-msg-agent';
      const t = document.createElement('div');
      t.className = 'demo-thinking';
      const dot = document.createElement('span');
      dot.className = 'demo-dot';
      const label = document.createElement('span');
      label.textContent = strings.thinking;
      t.append(dot, label);
      wrap.appendChild(t);
      thread.appendChild(wrap);
      toEnd();
      return wrap;
    };

    const tool = (name: string, result: string) => {
      const wrap = document.createElement('div');
      wrap.className = 'demo-msg demo-msg-agent';
      const box = document.createElement('div');
      box.className = 'demo-tools';
      const details = document.createElement('details');
      details.className = 'demo-tool';
      details.open = true;
      const summary = document.createElement('summary');
      const badge = document.createElement('span');
      badge.className = 'demo-tool-badge';
      badge.textContent = strings.toolLabel;
      const nm = document.createElement('span');
      nm.className = 'demo-tool-name';
      nm.textContent = name + '()';
      summary.append(badge, nm);
      const pre = document.createElement('pre');
      pre.textContent = result;
      details.append(summary, pre);
      box.appendChild(details);
      wrap.appendChild(box);
      thread.appendChild(wrap);
      toEnd();
    };

    const play = async (scenario: Step[], id: number) => {
      thread.replaceChildren();
      for (const step of scenario) {
        if (id !== runId) return;
        if (step.t === 'user') {
          await typeInto(bubble('user'), step.text, 24, id);
          await sleep(500);
        } else if (step.t === 'think') {
          const th = thinking();
          await sleep(1100);
          th.remove();
        } else if (step.t === 'tool') {
          tool(step.name, step.result);
          await sleep(900);
        } else {
          await typeInto(bubble('agent'), step.text, 15, id);
          await sleep(400);
        }
      }
    };

    const run = async () => {
      clearTimeout(loopTimer);
      const id = ++runId;
      running = true;
      replayBtn.disabled = true;
      await play(SCENARIOS[scenarioIdx], id);
      if (id !== runId) return;
      running = false;
      replayBtn.disabled = false;
      scenarioIdx = (scenarioIdx + 1) % SCENARIOS.length;
      // Gentle loop: after a pause, play the next scenario.
      if (!reduce) loopTimer = setTimeout(run, 4500);
    };

    replayBtn.addEventListener('click', () => { void run(); });

    // Start when the console scrolls into view.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          io.disconnect();
          void run();
        }
      },
      { threshold: 0.3 },
    );
    io.observe(root);
  }
</script>

# =============================================================================
# Sytadel Suite — production environment template
# =============================================================================
# Copy to `.env` at the repo root (gitignored, auto-loaded by docker compose):
#
#   cp env.production.example .env
#   # fill in every value below, then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# The production overlay is FAIL-CLOSED: if any secret below is unset,
# `docker compose config` errors out before a single container starts.
#
# Generate a strong random secret with:  openssl rand -hex 32
# =============================================================================

# --- Shared app secrets (JWT + internal service auth) ------------------------
# Cross-service: the same value must be read by several services. Do NOT
# desync them — each is one variable consumed in multiple places.
JWT_ACCESS_SECRET=
AUTH_JWT_REFRESH_SECRET=
INTERNAL_SERVICE_SECRET=
INTERNAL_HMAC_SECRET=
BILLING_INTERNAL_SERVICE_SECRET=
BILLING_INTERNAL_HMAC_SECRET=

# --- Database passwords ------------------------------------------------------
AUTH_DB_PASSWORD=
BILLING_DB_PASSWORD=
VAULT_DB_PASSWORD=            # vault-db superuser (bootstrap + migrations)
VAULT_APP_DB_PASSWORD=        # least-privilege app user used by vault-api
VAULT_APP_DB_USER=vault_app   # username is not secret; override if you want

# --- MinIO object storage (vault documents) ----------------------------------
# MINIO_ROOT_USER: min 3 chars. MINIO_ROOT_PASSWORD: min 8 chars.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Zero Trust gateway->Vault signing ---------------------------------------
# v1 HMAC secret — ACTIVE by default (the gateway signs HMAC unless flipped).
# Shared between zerotrust-api and vault-api; must match.
ZT_HMAC_SECRET=

# --- Vault envelope-encryption master key (KEK) ------------------------------
# THE key that protects every encrypted document. Guard it hardest.
# Must be 32 bytes, base64-encoded:   openssl rand -base64 32
# On a fresh prod (no data yet) any strong value is fine. Rotating later means
# bumping MASTER_KEY_VERSION and keeping prior keys available.
MASTER_KEY_B64=

# --- AI features (Anthropic) -------------------------------------------------
# Required only if the LLM features are on (anomaly classifier, policy
# generator, access review). Leave blank to run without them.
ANTHROPIC_API_KEY=

# --- Payments (billing-api) --------------------------------------------------
# Fill in for real checkout/webhooks. Blank = mock checkout only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com

# =============================================================================
# OPTIONAL — flip Zero Trust signing to asymmetric Ed25519 (v2)
# =============================================================================
# Leave unset to keep HMAC v1 (the default). To enable Ed25519:
#   1. Generate a keypair (kid must match on both sides).
#   2. Uncomment and fill:
# ZT_SIGN_MODE=ed25519
# ZT_SIGNING_KID=zt-2026-08
# ZT_SIGNING_PRIVATE_KEY=<base64 PEM>                 # zerotrust-api only, SECRET
# ZT_VERIFY_PUBLIC_KEYS={"zt-2026-08":"<PEM public>"}  # vault-api, non-secret
# Retire HMAC later with:  ZT_ACCEPT_V1_HMAC=false

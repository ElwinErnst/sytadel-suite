---
import BaseLayout from '../layouts/BaseLayout.astro';
import { locales, type Locale } from '../i18n/content';
import { getNav, getPagePath, type SitePage } from '../i18n/routes';

type Props = {
  lang: Locale;
  page: SitePage;
  title: string;
  description: string;
  languageLabel: string;
  footer: string;
};

const { lang, page, title, description, languageLabel, footer } = Astro.props;

const langNames: Record<Locale, string> = {
  es: 'ES',
  en: 'EN',
  pt: 'PT',
};

const topbarCtaLabels: Record<Locale, string> = {
  es: 'Comenzar',
  en: 'Get started',
  pt: 'Começar',
};

const GITHUB_URL = 'https://github.com/ElwinErnst/sentinel-suite';

const nav = getNav(lang);
---

<BaseLayout lang={lang} title={title} description={description}>
  <main class="site-shell">
    <div class="ambient ambient-left"></div>
    <div class="ambient ambient-right"></div>

    <header class="topbar" data-menu-open="false">
      <a class="brand" href={getPagePath(lang, 'home')}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 128 128" fill="none">
            <path
              d="M83.5 38.5H55.5C47.5 38.5 42 43 42 49.5C42 56.2 46.6 59.6 56.2 62.1L67 64.9C73.4 66.5 76 68.4 76 72C76 76.2 72.4 79 66.2 79H37.8"
              stroke="url(#brand-mark-stroke-web)"
              stroke-width="10"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M46 93.5H74C82 93.5 87.5 89 87.5 82.5C87.5 75.8 82.9 72.4 73.3 69.9L62.5 67.1C56.1 65.5 53.5 63.6 53.5 60C53.5 55.8 57.1 53 63.3 53H91.7"
              stroke="url(#brand-mark-stroke-web)"
              stroke-width="10"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <defs>
              <linearGradient
                id="brand-mark-stroke-web"
                x1="30"
                y1="26"
                x2="95"
                y2="102"
                gradientUnits="userSpaceOnUse"
              >
                <stop stop-color="#F8F2FF" />
                <stop offset="1" stop-color="#E6D8FF" />
              </linearGradient>
            </defs>
          </svg>
        </span>
        <span>Sytadel</span>
      </a>

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Abrir menú"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="topbar-menu" id="site-menu">
        <nav class="nav">
          {nav.map((item) => (
            <a class={page === 'home' ? '' : 'active'} href={item.href}>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="topbar-actions">
          <div class="lang-switcher" aria-label={languageLabel}>
            {locales.map((locale) => (
              <a
                class={locale === lang ? 'active' : ''}
                href={getPagePath(locale, page)}
              >
                {langNames[locale]}
              </a>
            ))}
          </div>

          <a
            class="topbar-github"
            href={GITHUB_URL}
            target="_blank"
            rel="noopener"
            aria-label="Sytadel Suite on GitHub"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.27-.01-1.16-.01-2.11-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.71 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.02 11.02 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.44-2.7 5.42-5.27 5.7.41.36.78 1.07.78 2.16 0 1.56-.02 2.82-.02 3.2 0 .31.21.67.79.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"
              />
            </svg>
            <span>GitHub</span>
          </a>

          <a class="button button-primary topbar-cta" href="https://app.sytadel-labs.com">
            {topbarCtaLabels[lang]}
          </a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="footer">
      <span>{footer}</span>
      <div class="footer-links">
        <a href={getPagePath(lang, 'home')}>Sytadel Labs</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
      </div>
    </footer>
  </main>

  <script is:inline>
    const topbar = document.querySelector('.topbar');
    const toggle = document.querySelector('.nav-toggle');
    const menu = document.querySelector('.topbar-menu');

    if (topbar && toggle && menu) {
      const syncMenu = (open) => {
        topbar.setAttribute('data-menu-open', String(open));
        toggle.setAttribute('aria-expanded', String(open));
      };

      toggle.addEventListener('click', () => {
        const isOpen = topbar.getAttribute('data-menu-open') === 'true';
        syncMenu(!isOpen);
      });

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => syncMenu(false));
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth > 720) {
          syncMenu(false);
        }
      });
    }
  </script>

  <style>
    .topbar-github {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: inherit;
      opacity: 0.85;
      text-decoration: none;
      padding: 6px 10px;
      border-radius: 6px;
      transition: opacity 0.15s ease, background 0.15s ease;
    }

    .topbar-github:hover {
      opacity: 1;
      background: rgba(255, 255, 255, 0.06);
    }

    .topbar-github svg {
      display: block;
    }

    .footer-links {
      display: inline-flex;
      gap: 16px;
    }
  </style>
</BaseLayout>
